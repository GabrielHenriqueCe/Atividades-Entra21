@model MVC.Models.Aluno

<h1>Cadastrar Aluno</h1>

<form asp-action="Criar" method="post">
    <div>
        <label>Nome</label>
        <input type="text" asp-for="Nome" />
        <span asp-validation-for="Nome" style="color: red;"></span>
    </div>
    <div>
        <label>Email</label>
        <input type="email" asp-for="Email" />
        <span asp-validation-for="Email" style="color: red;"></span>
    </div>
    <div>
        <label>Data de Nascimento</label>
        <input type="date" asp-for="DataNascimento" />
        <span asp-validation-for="DataNascimento" style="color: red;"></span>
    </div>
    <div>
        <label>Telefone</label>
        <input type="text" asp-for="Telefone" />
    </div>
    <button type="submit">Salvar</button>
</form>