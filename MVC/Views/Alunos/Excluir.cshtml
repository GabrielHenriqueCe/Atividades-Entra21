@model MVC.Models.Aluno

<h1>Confirmar exclusão</h1>

<p>Tem certeza que deseja excluir este aluno?</p>

<table>
    <tr>
        <th>Nome</th>
        <td>@Model.Nome</td>
    </tr>
    <tr>
        <th>Email</th>
        <td>@Model.Email</td>
    </tr>
    <tr>
        <th>Data de Nascimento</th>
        <td>@Model.DataNascimento?.ToString("dd/MM/yyyy")</td>
    </tr>
    <tr>
        <th>Telefone</th>
        <td>@Model.Telefone</td>
    </tr>
</table>

<form asp-action="ExcluirConfirmado" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit">Confirmar exclusão</button>
</form>