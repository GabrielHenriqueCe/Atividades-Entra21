@model List<MVC.Models.Produto>

<h1>Produtos</h1>

<p>
    <a asp-action="Criar">Cadastrar novo produto</a>
</p>

<style>
    table {
        border-collapse: collapse;
        width: 100%;
        margin-top: 16px;
        background-color: var(--bg-elev);
    }

    th, td {
        border: 1px solid var(--line);
        padding: 10px 16px;
        text-align: left;
        color: var(--ink);
    }

    th {
        background-color: var(--bg-elev-2);
        color: var(--accent);
    }

    tr:nth-child(even) {
        background-color: var(--bg-elev-2);
    }
</style>

<table>
    <thead>
        <tr>
            <th>Id</th>
            <th>Nome</th>
            <th>Preço</th>
            <th>Ações</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var produto in Model)
        {
            <tr>
                <td>@produto.Id</td>
                <td>@produto.Nome</td>
                <td>@produto.Preco.ToString("C")</td>
                <td>
                    <a asp-action="Editar" asp-route-id="@produto.Id">Editar</a><br />
                    <a asp-action="Excluir" asp-route-id="@produto.Id">Excluir</a>
                </td>
            </tr>
        }
    </tbody>
</table>