@model MVC.Models.Produto

<h1>Cadastrar Produto</h1>

<form asp-action="Criar" method="post">
    <div>
        <label>Nome</label>
        <input type="text" asp-for="Nome" />
        <span asp-validation-for="Nome" style="color: red;"></span>
    </div>
    <div>
        <label>Preço</label>
        <input type="number" step="0.01" asp-for="Preco" />
        <span asp-validation-for="Preco" style="color: red;"></span>
    </div>
    <button type="submit">Salvar</button>
</form>